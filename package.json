{
  "name": "cadence-listy",
  "version": "0.1.0",
  "description": "Themed wish lists you can share with a link. Runs on Cloudflare Workers.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --test-scheduled",
    "build": "vite build && node scripts/add-cleanup.js",
    "deploy": "npm run build && wrangler deploy",
    "check": "svelte-kit sync && svelte-check"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/anton": "^5.3.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.0.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
